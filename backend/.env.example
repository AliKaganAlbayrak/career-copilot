# Bu dosyayı .env olarak kopyala ve kendi değerlerini yaz.
# .env dosyası .gitignore'da: gerçek anahtarlar repoya girmez.

DATABASE_URL=sqlite:///./career.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT imzalama anahtarı. Üretimde mutlaka uzun, rastgele bir değer kullan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-beni-en-az-32-karakter-olmali
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Yapay zekâ: yerelde çalışan Ollama sunucusu ve kullanılacak model.
# Veri bilgisayarından çıkmaz; kurulum için: https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
